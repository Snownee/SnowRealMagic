{
	"multipart": [
		{
			"when": {
				"up": "true"
			},
			"apply": {
				"model": "snowrealmagic:block/wall_post"
			}
		},
		{
			"when": {
				"north": "low"
			},
			"apply": {
				"model": "snowrealmagic:block/wall_side",
				"uvlock": true
			}
		},
		{
			"when": {
				"east": "low"
			},
			"apply": {
				"model": "snowrealmagic:block/wall_side",
				"y": 90,
				"uvlock": true
			}
		},
		{
			"when": {
				"south": "low"
			},
			"apply": {
				"model": "snowrealmagic:block/wall_side",
				"y": 180,
				"uvlock": true
			}
		},
		{
			"when": {
				"west": "low"
			},
			"apply": {
				"model": "snowrealmagic:block/wall_side",
				"y": 270,
				"uvlock": true
			}
		},
		{
			"__comment": "make it render anyway",
			"apply": {
				"model": "minecraft:block/air"
			}
		}
	]
}